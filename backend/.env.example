# Copy to `.env` and fill in real values for local development.
# NEVER commit a real .env file.

APP_NAME=SocialGrowth AI
ENVIRONMENT=development
DEBUG=true

JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

CORS_ORIGINS=["http://localhost:5173"]

DATABASE_URL=postgresql+asyncpg://socialgrowth:socialgrowth@postgres:5432/socialgrowth
SYNC_DATABASE_URL=postgresql+psycopg2://socialgrowth:socialgrowth@postgres:5432/socialgrowth

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Object storage (S3 or Cloudflare R2) — leave blank in dev; StorageService
# will raise clearly if asset generation is attempted without these set.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=socialgrowth-assets
S3_REGION=auto
S3_PUBLIC_BASE_URL=

# AI providers — "mock" requires no keys and is the safe default for local dev/tests.
LLM_PROVIDER=mock
IMAGE_PROVIDER=mock
VIDEO_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
STABILITY_API_KEY=

# Gemini (Google AI) — set IMAGE_PROVIDER=gemini and/or VIDEO_PROVIDER=gemini
# above to use these. Get a key at https://aistudio.google.com/apikey.
# Video (Veo) is billed per output-second with no free tier; image
# generation (Gemini 2.5 Flash Image / "Nano Banana") has a free tier.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview

# Social platform OAuth (Phase 3)
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SENTRY_DSN=
LOG_LEVEL=INFO
LOG_JSON=false
